            "activity": "Setup",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@equals(toLower(if(empty(pipeline().parameters.p_run_tests), pipeline().libraryVariables.bootstrap_run_tests, pipeline().parameters.p_run_tests)), 'true')",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "TridentNotebook",
              "typeProperties": {
