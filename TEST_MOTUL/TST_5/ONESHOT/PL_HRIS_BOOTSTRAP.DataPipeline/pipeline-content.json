{
  "properties": {
    "description": "Premier chargement guidé, lancé à la main, jamais planifié : installation (SETUP), tests sur données fictives si demandés (p_run_tests ou variable bootstrap_run_tests), choix du mode (INIT_REFERENCE si la référence est vide, sinon NORMAL), run complet de T5_PL_HRIS_ORCHESTRATOR, puis action suivante. Rejouable sans risque.",
    "activities": [
      {
        "type": "TridentNotebook",
        "typeProperties": {
          "notebookId": "1f83481d-7d71-4f66-b603-0168f1ae14da",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "parameters": {}
        },
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Setup",
        "dependsOn": []
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@not(equals(json(activity('Setup').output.result.exitValue).status, 'OK'))",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "Fail",
              "typeProperties": {
                "message": "Socle incompatible : une table existante diffère du modèle (voir la sortie de l'activité Setup). Aucun run lancé.",
                "errorCode": "HRIS_SETUP_INCOMPATIBLE"
              },
              "name": "SetupIncompatible",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": []
