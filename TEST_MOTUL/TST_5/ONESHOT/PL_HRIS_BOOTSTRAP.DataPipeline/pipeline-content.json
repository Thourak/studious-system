                "parameters": {
                  "p_test_schema": {
                    "value": {
                      "value": "hris_tst",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "p_run_integration": {
                    "value": {
                      "value": "true",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "p_fail_on_error": {
                    "value": {
                      "value": "true",
                      "type": "Expression"
                    },
                    "type": "string"
                  }
                }
              },
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Tests",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": []
        },
        "name": "IfRunTests",
        "dependsOn": [
          {
            "activity": "IfSetupIncompatible",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "TridentNotebook",
        "typeProperties": {
          "notebookId": "9198c091-31e8-451a-8558-09eb82ec65f4",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
